# App Store Connect API (Users and Access > Integrations > App Store Connect API)
# Use a key with the App Manager role. Keep the .p8 file outside this repo.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Safety: set to true to block every write tool
ASO_READ_ONLY=false

# Where the change log, rank snapshots, and CSV imports live (default ./.aso)
# ASO_DATA_DIR=

# Keyword data providers (comma separated). Default: every configured one.
# Options: apptweak, csv, itunes
# ASO_PROVIDERS=apptweak,csv,itunes

# AppTweak
APPTWEAK_API_KEY=

# Appfigures: add its official MCP server instead (see README)
# APPFIGURES_API_KEY=
